# ==============================================================================
# Sentiva RAG Demo — per-environment configuration.
# Copy to config.env and fill in your values:  cp config.env.example config.env
# config.env is gitignored (holds environment-specific values).
# ==============================================================================

# Databricks CLI profile (must exist in ~/.databrickscfg). Workspace host comes from it.
export PROFILE="DEFAULT"

# Unity Catalog naming (any names; created by the scripts)
export CATALOG="dbx_agent_lakebase"
export SCHEMA="rag"

# Lakebase (Postgres Autoscaling) project id
export LAKEBASE_PROJECT="sentiva-rag"

# Serverless SQL warehouse id (for ai_parse_document / ai_prep_search). REQUIRED.
export WAREHOUSE_ID="<your-serverless-sql-warehouse-id>"

# Model endpoints (Databricks-hosted). Swap LLM if a model is retired.
export LLM_ENDPOINT="databricks-gemini-3-5-flash"
export EMBEDDING_ENDPOINT="databricks-qwen3-embedding-0-6b"

# Databricks App names
export APP_A_NAME="sentiva-agent-api"
export APP_B_NAME="sentiva-web"

# Unity AI Gateway model-service id (created in $CATALOG.$SCHEMA)
export GATEWAY_SERVICE_ID="sentiva_llm"

# MLflow experiment (bound to a UC trace location at creation) + OTel table prefix
export MLFLOW_EXPERIMENT="/Shared/sentiva-rag-traces"
export TRACE_TABLE_PREFIX="sentiva"
export RETRIEVAL_K="5"

# ------------------------------------------------------------------------------
# Catalog managed storage root:
#   - "DEFAULT"        -> create catalog with the metastore's default managed storage
#   - "s3://.../<cat>" -> an external location you can write to (some metastores require this)
#   - ""  (empty)      -> scripts/detect_storage_root.sh will suggest one (needs confirmation)
export CATALOG_STORAGE_ROOT="<s3://your-external-location/dbx_agent_lakebase-or-DEFAULT>"
